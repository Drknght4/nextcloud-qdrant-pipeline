# ── Nextcloud WebDAV ──────────────────────────────────────────────
NEXTCLOUD_URL=http://localhost:8667
NEXTCLOUD_USER=your-nextcloud-user
NEXTCLOUD_APP_PASSWORD=your-app-password

# ── Embedding (Infinity bge-m3) ──────────────────────────────────
INFINITY_URL=http://localhost:7997
INFINITY_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=default

# ── Inbox Sync Daemon ─────────────────────────────────────────────
NEXTCLOUD_INBOX=Qdrant Inbox
RAG_PIPELINE_DIR=$HOME/rag-pipeline
POLL_INTERVAL=30

# ── Telegram Notifications (optional) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=